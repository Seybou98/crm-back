# Configuration Backend - Label Energie CRM
# Variables d'environnement pour le serveur backend

# YouSign Configuration
YOUSIGN_API_KEY=your_yousign_api_key_here
YOUSIGN_API_URL=https://api-sandbox.yousign.app/v3

# GoCardless Configuration
GOCARDLESS_ACCESS_TOKEN=your_gocardless_access_token_here
GOCARDLESS_CREDITOR_ID=your_gocardless_creditor_id_here

# Server Configuration
PORT=3002
NODE_ENV=development

# Frontend URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:3000

# Firebase Configuration (si nécessaire pour le backend)
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# ⚠️ INSTRUCTIONS IMPORTANTES :
# 1. Remplacer "your_*_here" par vos vraies clés
# 2. Pour YouSign, utiliser la clé API de votre compte
# 3. Pour GoCardless, utiliser vos clés de test ou production
# 4. Ne jamais commiter ce fichier dans Git
